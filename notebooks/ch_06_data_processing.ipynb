        "import ray\n",
        "ds = ray.data.range(10000)\n",
        "\n",
        "# Convert the Dataset to a Dask DataFrame.\n",
        "df = ds.to_dask()\n",
        "print(df.std().compute())  # -> 2886.89568\n",
        "\n",
        "# Convert the Dask DataFrame back to a Dataset.\n",
        "ds = ray.data.from_dask(df)\n",
        "print(ds.std())  # -> 2886.89568"
